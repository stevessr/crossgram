[Unit]
Description=Crossgram MTProto relay
Wants=network-online.target
After=network-online.target qqnt-bridge.service

[Service]
Type=simple
User=crossgram
Group=crossgram
WorkingDirectory=/opt/crossgram
Environment=NODE_ENV=production
Environment="NODE_OPTIONS=--import tsx --import @cordisjs/unyaml"
Environment=HOME=/var/lib/crossgram
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/qqnt-bridge.env
EnvironmentFile=-/etc/crossgram.env
ExecStart=/usr/bin/env corepack yarn cordis run /opt/crossgram/.runtime/app.yml
Restart=always
RestartSec=5s
TimeoutStopSec=30s
# A relay keeps very little data in flight, so its latency is decided by where
# its few reads and writes land in the block layer's queue. On a host that
# shares one disk with bulk tenants, best-effort class at priority 0 keeps a
# Telegram request from waiting behind someone else's backup write.
IOSchedulingClass=best-effort
IOSchedulingPriority=0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/crossgram /opt/crossgram/.runtime

[Install]
WantedBy=multi-user.target
